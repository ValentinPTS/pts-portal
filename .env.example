# Copy to .env.local and fill in. NEVER commit real values.
# Without these, the app runs on an in-memory store. With them, it persists to Supabase.
# See SUPABASE-SETUP.md.

# Supabase — your dedicated PTS project, EU region (Frankfurt)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=                 # publishable/anon key (Phase 1). Server-side only.
                                # Phase 2: switch to a secret server key + auth-scoped RLS.

# ── Owner authentication (Phase 2) ──────────────────────────────────────────
# Auth is SCAFFOLDED OFF by default — the app stays open. To switch it on:
#   1) set AUTH_ENABLED=true
#   2) set NEXT_PUBLIC_SUPABASE_ANON_KEY to the publishable/anon key (browser-safe)
#   3) set OWNER_EMAILS to the 3 owners' login emails (comma-separated)
#   4) create those users in Supabase Auth; each enrols an authenticator app (TOTP) at /account
# Until the /login + /account UI is built and the above is set, leave AUTH_ENABLED unset.
# AUTH_ENABLED=true
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alias — a newer project
#    calls this key 'publishable' rather than 'anon'. Set either one, not both.)
# OWNER_EMAILS=belovski@example.com,kasabova@example.com,partner@example.com
# With auth ON, set a long random secret so owner PDF export works (the headless
# browser uses it to fetch render routes past the owner-area gate). Keep it secret.
# INTERNAL_TOKEN=<64+ random hex chars>

# Claude API (BG→EN translate helper) — server-only (Phase 1 optional)
# ANTHROPIC_API_KEY=

# PAdES document signing certificate (Phase 3) — server-only
# SIGNING_CERT_PATH=
# SIGNING_CERT_PASSPHRASE=

# ── Notification e-mail (built, never yet switched on) ──────────────────────
# Without MAIL_PROVIDER the app is SILENT: notices are still recorded in the
# outbox and shown in the bell, they are simply never delivered. That is the
# intended off state, so nothing warns you — which is exactly why these belong
# in this file rather than only in someone's memory.
#
# MAIL_FROM must be a SINGLE VERIFIED SENDER. Both providers verify one address
# by mailing it a confirmation link, so this never depends on DNS for a domain
# you do not control.
# MAIL_PROVIDER=resend          # resend | sendgrid
# MAIL_API_KEY=
# MAIL_FROM=ptsolutionsbg@gmail.com
# PTS_NOTIFY_EMAIL=ptsolutionsbg@gmail.com   # where provider-side notices go
# NEXT_PUBLIC_SITE_URL=https://…             # absolute links inside the e-mails

# The daily 06:00 cron (vercel.json → /api/cron/notify) raises the day-before
# reminders and flushes the outbox. WITHOUT this secret the route returns 503
# rather than running unauthenticated — set it or the cron does nothing.
# CRON_SECRET=<long random string>

# ── Local development conveniences ──────────────────────────────────────────
# Two-factor is required for the owner area by default. Set this to false while
# hopping between Manager / Staff / Auditor accounts; keep it ON for real use.
# REQUIRE_2FA=false
#
# Seeds the two demo schemes on first load. ONLY use this with the Supabase vars
# EMPTY (in-memory store) — pointing it at a real database writes demo data into
# it. A gitignored .env.development.local overrides .env.local and is the safe
# place for this pairing.
# SEED_DEMO=true
